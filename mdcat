#!/usr/bin/env bash
# Thin launcher so `mdcat file.md` works directly, without needing to
# invoke python3 yourself. Resolves symlinks so it still finds mdcat.py
# next to the real script even when called through a symlinked name.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    [[ $src != /* ]] && src="$dir/$src"
done
dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
exec python3 "$dir/mdcat.py" "$@"
